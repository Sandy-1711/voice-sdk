{
  "name": "@swungstudent/voice",
  "version": "0.2.1",
  "description": "Provider-agnostic types and helpers for text-to-speech and speech-to-text, batch and realtime.",
  "keywords": [
    "voice",
    "tts",
    "stt",
    "text-to-speech",
    "speech-to-text",
    "realtime",
    "sdk"
  ],
  "license": "MIT",
  "author": "Sandy-1711",
  "homepage": "https://github.com/Sandy-1711/voice-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandy-1711/voice-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Sandy-1711/voice-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@voice-sdk/eslint-config": "workspace:*",
    "@voice-sdk/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }
}
