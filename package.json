{
  "name": "voice-sdk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:live": "turbo run test:live",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter=@swungstudent/voice --filter=./providers/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
