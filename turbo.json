{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:live": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["CARTESIA_API_KEY", "DEEPGRAM_API_KEY", "ELEVENLABS_API_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
