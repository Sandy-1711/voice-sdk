{
  "tabWidth": 4,
  "printWidth": 110,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.yml", "*.yaml", "*.md"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": ["apps/**", "packages/ui/**", "packages/eslint-config/**", "**/tsup.config.ts"],
      "options": { "tabWidth": 2 }
    }
  ]
}
